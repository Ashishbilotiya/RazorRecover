# Database (production: PostgreSQL; tests: sqlite:///:memory:)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/razorrecover

# Application environment — one of: development | test | production
APP_ENV=development

# Razorpay Test Mode
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx

# LLM provider (provider abstraction — do not couple code to one vendor)
LLM_PROVIDER=anthropic
LLM_API_KEY=xxxxxxxxxxxxxxxxxxxx
LLM_MODEL=claude-sonnet-4-6

# Recovery policy knobs (used from Phase 4 onward)
RECOVERY_RETRY_LIMIT=3
RECOVERY_CONFIDENCE_THRESHOLD=0.75
RECOVERY_AMOUNT_ESCALATION_LIMIT=50000
